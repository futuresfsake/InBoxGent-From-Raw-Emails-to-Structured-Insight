#!/bin/sh
# Stage 2: full tests before push. Direct pushes to main are allowed only until branch
# protection is enabled (M0-10); then set INBOXGENT_PROTECT_MAIN=1 or remove this exception.
branch=$(git rev-parse --abbrev-ref HEAD)
if [ "$branch" = "main" ] && [ "${INBOXGENT_PROTECT_MAIN:-0}" = "1" ]; then
  echo "Refusing direct push to main. Use a work branch and a pull request." >&2
  exit 1
fi
exec python -m pytest -q
